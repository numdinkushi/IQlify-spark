# IQlify environment variables

# --- Convex ---
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site
CONVEX_DEPLOY_KEY=

# --- Vapi (voice interviews) ---
NEXT_PUBLIC_VAPI_ENABLED=false
NEXT_PUBLIC_VAPI_WEBTOKEN=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPI_TECHNICAL_ASSISTANT_ID=
NEXT_PUBLIC_VAPI_SOFT_SKILLS_ASSISTANT_ID=
NEXT_PUBLIC_VAPI_BEHAVIORAL_ASSISTANT_ID=
NEXT_PUBLIC_VAPI_SYSTEM_DESIGN_ASSISTANT_ID=

# --- Google Gemini (interview grading) ---
NEXT_PUBLIC_GEMINI_API_KEY=

# --- WalletConnect (RainbowKit) ---
# Create one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Monad network ---
# testnet | mainnet — switches chain, RPC, and reward contract in one place
NEXT_PUBLIC_MONAD_NETWORK=testnet
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143

# Reward contract per network (active one picked by NEXT_PUBLIC_MONAD_NETWORK)
NEXT_PUBLIC_REWARD_CONTRACT_ADDRESS_TESTNET=
NEXT_PUBLIC_REWARD_CONTRACT_ADDRESS_MAINNET=
# Legacy single-address fallback (optional)
NEXT_PUBLIC_REWARD_CONTRACT_ADDRESS=

# Server-only — signs reward claim vouchers
REWARD_SIGNER_PRIVATE_KEY=
# Server-only — deploys contracts (needs MON on the target network)
DEPLOYER_PRIVATE_KEY=

# --- Cloudinary (profile images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:3000
